# ── Sarvam AI ──
SARVAM_API_KEY=your_sarvam_api_key

# ── Bhashini (optional fallback) ──
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_USER_ID=your_user_id
BHASHINI_PIPELINE_ID=optional_asr_pipeline_id

# ── Groq ASR (FREE, no card, instant key — RECOMMENDED) ──
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=whisper-large-v3-turbo

# ── AI4Bharat IndicConformer (free local Maithili ASR, MIT) ──
USE_INDIC_CONFORMER=true
INDIC_MAITHILI_MODEL=ai4bharat/indicconformer_stt_mai_hybrid_ctc_rnnt_large

# ── LLM (Gemini free tier) ──
GEMINI_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-3.5-flash

# ── Database ──
DATABASE_URL=postgresql://user:pass@localhost:5432/ambient_scribe

# ── Backend ──
WS_HOST=0.0.0.0
WS_PORT=8765
AUDIO_DELETE_AFTER_TRANSCRIBE=true

# ── Capture Agent ──
BACKEND_WS_URL=ws://your-server:8765/ws/chunks
MIC_DEVICE=0
SAMPLE_RATE=16000

# ── Local ASR fallback (faster-whisper, $0, Hindi-only) ──
USE_LOCAL_FALLBACK=true
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
